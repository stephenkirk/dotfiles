#!/usr/bin/env bash
# Count lines containing /skill-name under ~/.claude/projects.
# Names come from global and local skills; matches are not verified invocations.

GLOBAL_SKILLS="$HOME/.claude/skills"
LOCAL_SKILLS="$PWD/.claude/skills"
PROJECTS_DIR="$HOME/.claude/projects"

skills=""

printf "%-25s %-12s %s\n" "SKILL" "INVOCATIONS" "SOURCE"
printf "%-25s %-12s %s\n" "-------------------------" "------------" "------"

{
  for dir in "$GLOBAL_SKILLS" "$LOCAL_SKILLS"; do
    [ -d "$dir" ] || continue
    if [ "$dir" = "$GLOBAL_SKILLS" ]; then
      src="global"
    else
      src="local"
    fi
    for skill in "$dir"/*/; do
      [ -d "$skill" ] || continue
      name=$(basename "$skill")
      # Global names are visited first; skip matching local names.
      echo "$skills" | grep -qw "$name" && continue
      skills="$skills $name"
      count=$(rg -c "/$name" "$PROJECTS_DIR" 2>/dev/null | awk -F: '{s+=$NF} END {print s+0}')
      printf "%-25s %-12d %s\n" "$name" "$count" "$src"
    done
  done
} | sort -rn -k2
