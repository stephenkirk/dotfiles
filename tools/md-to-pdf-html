#!/bin/bash
# Convert the given .md file, or all .md files here, to PDFs in OUTPUT/.
# Uses pandoc and wkhtmltopdf; overwrites and removes custom.css in this directory.

cat << EOF > custom.css
body {
    font-family: "Helvetica Neue", sans-serif;
    font-size: 12pt;
}
EOF

mkdir -p OUTPUT

if [ $# -gt 0 ]; then
    file="$1"
    if [ -f "$file" ] && [[ "$file" == *.md ]]; then
        filename=$(basename "$file" .md)
        pandoc "$file" -t html5 --pdf-engine=wkhtmltopdf --css=custom.css -o "OUTPUT/${filename}.pdf"
        echo "Converted $file to OUTPUT/${filename}.pdf"
    else
        echo "Error: $file is not a valid Markdown file."
        rm custom.css
        exit 1
    fi
else
    for file in *.md; do
        if [ -f "$file" ]; then
            filename=$(basename "$file" .md)
            pandoc "$file" -t html5 --pdf-engine=wkhtmltopdf --css=custom.css -o "OUTPUT/${filename}.pdf"
            echo "Converted $file to OUTPUT/${filename}.pdf"
        fi
    done
fi

rm custom.css

echo "Conversion complete. Check the OUTPUT folder for your PDF files."
