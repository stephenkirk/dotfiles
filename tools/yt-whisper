#!/bin/bash

# Transcribe YouTube audio to a title-named .txt file in the current directory.
# Usage: yt-whisper URL [START_TIME [END_TIME]]

command -v yt-dlp >/dev/null 2>&1 || { echo "Error: yt-dlp is required but not installed. Install with 'pip install yt-dlp'"; exit 1; }
command -v whisper >/dev/null 2>&1 || { echo "Error: OpenAI Whisper is required but not installed. Install with 'pip install -U openai-whisper'"; exit 1; }
command -v ffmpeg >/dev/null 2>&1 || { echo "Error: ffmpeg is required but not installed."; exit 1; }

if [ -z "$1" ]; then
    echo "Error: YouTube URL is required"
    echo "Usage: $0 [youtube_url] [start_time (optional)] [end_time (optional)]"
    exit 1
fi

URL="$1"
START_TIME="$2"
END_TIME="$3"
TEMP_DIR=$(mktemp -d)
AUDIO_FILE="$TEMP_DIR/audio.mp3"

cleanup() {
    echo "Cleaning up temporary files..."
    rm -rf "$TEMP_DIR"
}

trap cleanup EXIT


echo "Getting title..."
VIDEO_TITLE=$(yt-dlp --get-title "$URL" | sed 's/[^a-zA-Z0-9._-]/_/g')
FILENAME="$VIDEO_TITLE.txt"

echo "$VIDEO_TITLE"

echo "Downloading audio from YouTube..."

YT_ARGS=(-x --audio-format mp3 --audio-quality 2)
if [ -n "$START_TIME" ] && [ -n "$END_TIME" ]; then
    YT_ARGS+=(--download-sections "*$START_TIME-$END_TIME")
elif [ -n "$START_TIME" ]; then
    YT_ARGS+=(--download-sections "*$START_TIME-")
fi
yt-dlp "${YT_ARGS[@]}" -o "$AUDIO_FILE" "$URL"

if [ ! -f "$AUDIO_FILE" ]; then
    echo "Error: Failed to download audio"
    exit 1
fi

echo "Transcribing audio with Whisper..."

if ! whisper "$AUDIO_FILE" --model base --output_format txt --output_dir "$TEMP_DIR"; then
    echo "Error: Whisper transcription failed"
    exit 1
fi

cat "$TEMP_DIR"/*.txt > "$FILENAME"

echo "Transcription complete."
