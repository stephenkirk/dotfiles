#!/usr/bin/env bash

# Show my merged PRs from the past N days with titles and bodies.

days="${1:-7}"
since=$(date -v-"${days}"d +%Y-%m-%d)

gh pr list --author @me --state merged \
  --search "merged:>=${since}" \
  --json number,title,body,url,mergedAt \
  --jq '.[] | "## \(.title)\n\(.url)\nMerged: \(.mergedAt)\n\n\(.body)\n\n---\n"'
