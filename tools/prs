#!/usr/bin/env bash

# List PRs in the current repository. Lists use Markdown links; merged includes bodies.
#
#   prs inbox        others' open non-draft PRs with no reviews
#   prs waiting      my open PRs without approval or change requests
#   prs approved     my open PRs that are approved (ready to merge)
#   prs merged [N]   my merged PRs from the past N days (default 7)

set -euo pipefail

usage() {
  sed -n '3,9p' "$0" | sed 's/^# \{0,1\}//'
  exit 1
}

cmd="${1:-}"

case "$cmd" in
  inbox)
    gh pr list -S "is:open draft:false review:none -author:@me" --json title,url,author \
      --jq 'map("[\"@\(.author.login): \(.title)\"](\(.url))") | .[]'
    ;;

  waiting)
    gh pr list --author @me --state open \
      --json title,url,reviewDecision,isDraft \
      --jq '.[] | select(.reviewDecision != "APPROVED" and .reviewDecision != "CHANGES_REQUESTED") | "[\(.title)](\(.url))"'
    ;;

  approved)
    gh pr list --author @me --state open \
      --json number,title,url,reviewDecision \
      --jq '.[] | select(.reviewDecision == "APPROVED") | "[#\(.number) \(.title)](\(.url))"'
    ;;

  merged)
    days="${2:-7}"
    since=$(date -v-"${days}"d +%Y-%m-%d)
    gh pr list --author @me --state merged \
      --search "merged:>=${since}" \
      --json title,body,url,mergedAt \
      --jq '.[] | "## \(.title)\n\(.url)\nMerged: \(.mergedAt)\n\n\(.body)\n\n---\n"'
    ;;

  *)
    usage
    ;;
esac
