#!/bin/bash

# Lint tracked .rb and .rake files changed on this branch or in the working tree.

set -e

git_root=$(git rev-parse --show-toplevel)

# Change to the git root to ensure RuboCop finds .rubocop.yml and .rubocop_todo.yml
cd "$git_root" || exit 1

if git rev-parse --verify origin/main &> /dev/null; then
  base_branch="origin/main"
elif git rev-parse --verify main &> /dev/null; then
  base_branch="main"
elif git rev-parse --verify origin/master &> /dev/null; then
  base_branch="origin/master"
elif git rev-parse --verify master &> /dev/null; then
  base_branch="master"
else
  echo "Error: Could not find main or master branch"
  exit 1
fi

merge_base=$(git merge-base "$base_branch" HEAD)

# Compare from the fork point to exclude later changes on the base branch.
changed_ruby_files=$(git diff --name-only --diff-filter=ACMR "$merge_base" HEAD | grep -E '\.(rb|rake)$' || true)

# Also include any uncommitted changes (staged or unstaged)
uncommitted_ruby_files=$(git diff --name-only --diff-filter=ACMR HEAD | grep -E '\.(rb|rake)$' || true)
staged_ruby_files=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(rb|rake)$' || true)

all_files=$(echo -e "${changed_ruby_files}\n${uncommitted_ruby_files}\n${staged_ruby_files}" | sort -u | grep -v '^$' || true)

existing_files=""
for file in $all_files; do
  if [ -f "$file" ]; then
    existing_files="$existing_files $file"
  fi
done

existing_files=$(echo "$existing_files" | xargs)

if [ -z "$existing_files" ]; then
  echo "✅ No Ruby files changed on this branch."
  exit 0
fi

if ! command -v bundle &> /dev/null; then
  echo "Error: bundle command not found."
  exit 1
fi

file_count=$(echo "$existing_files" | wc -w | xargs)

echo "🔍 Running RuboCop on $file_count Ruby file(s) changed on this branch (compared to $base_branch)..."
echo ""

# --force-exclusion ensures Exclude patterns from .rubocop.yml and .rubocop_todo.yml are respected
# Capture failures so set -e does not skip the summary.
rubocop_exit_code=0
bundle exec rubocop --force-exclusion $existing_files || rubocop_exit_code=$?

echo ""
if [ $rubocop_exit_code -ne 0 ]; then
  echo "❌ RuboCop found offenses. Please fix them before opening your PR."
  echo "💡 You can run 'bundle exec rubocop -a <file>' to auto-correct some offenses."
  exit 1
fi

echo "✅ RuboCop check passed! Ready for PR."
exit 0
